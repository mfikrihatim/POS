NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=POS
DB_SSL=false
# Atau pakai satu URL (prioritas lebih tinggi jika diisi), mis. dari Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Auth
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=12h

# Toko (dipakai di struk & email)
STORE_NAME=Toko Maju Jaya
STORE_ADDRESS=Jl. Merdeka No. 10, Jakarta
STORE_PHONE=021-555-0101
TAX_PERCENT=11

# CORS (pisahkan dengan koma). Kosongkan jika FE disajikan oleh BE yang sama.
CORS_ORIGIN=http://localhost:4200

# Midtrans Sandbox (https://dashboard.sandbox.midtrans.com > Settings > Access Keys)
# Jika kosong, pembayaran non-tunai berjalan dalam MODE SIMULASI.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# SMTP Email (mis. Gmail: smtp.gmail.com, port 465, secure=true, pakai App Password)
# Jika kosong, email tidak dikirim tetapi disimpan sebagai file HTML di BE/tmp/mails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Toko Maju Jaya <no-reply@tokomaju.id>"
